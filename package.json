{
  "name": "lux-legal-agent-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "eval:agent:luna": "node eval/compose.mjs --mode agent --model openai/gpt-6-luna --judge-model openai/gpt-6-luna",
    "eval:agent:luna:voyage": "LX_RETRIEVAL_PROFILE=voyage node eval/compose.mjs --mode agent --model openai/gpt-6-luna --judge-model openai/gpt-6-luna",
    "test": "node --test tests/*.test.mjs runtime/tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "runtime": "node runtime/cli.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "@pierre/storage": "1.17.1",
    "ajv": "8.20.0",
    "cron-parser": "5.10.1",
    "e2b": "2.51.0",
    "rrule": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "typescript": "7.0.2"
  }
}
